{
  "name": "la-parada",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:functions": "tsc -p firebase-functions/tsconfig.json",
    "build:all": "pnpm run build && pnpm run build:functions",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-la-parada-rules-test --only auth,firestore,storage \"vitest run --no-file-parallelism tests/firebase.rules.test.ts tests/deliveryFinalization.integration.test.ts firebase-functions/test/publicOrder.integration.test.ts firebase-functions/test/staffUser.integration.test.ts firebase-functions/test/whatsapp.integration.test.ts\"",
    "seed:e2e": "node firebase-functions/scripts/seed-e2e.mjs",
    "verify:e2e": "node firebase-functions/scripts/verify-e2e.mjs",
    "seed:staff-e2e": "node firebase-functions/scripts/seed-staff-e2e.mjs",
    "verify:staff-e2e": "node firebase-functions/scripts/verify-staff-e2e.mjs",
    "seed:tenant-e2e": "node firebase-functions/scripts/seed-tenant-e2e.mjs",
    "preview": "vite preview",
    "firebase": "firebase",
    "deploy": "firebase deploy"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "firebase-tools": "^15.28.1",
    "postcss": "^8.4.32",
    "sharp": "0.35.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
