rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuth()
        && request.auth.token.email == 'andres.san1404@gmail.com';
    }

    function userProfilePath() {
      return /databases/$(database)/documents/usuarios_negocio/$(request.auth.uid);
    }

    function hasProfileForTenant(negocioId) {
      return isAuth()
        && exists(userProfilePath())
        && get(userProfilePath()).data.activo == true
        && get(userProfilePath()).data.negocioId == negocioId;
    }

    function tenantIsActive(negocioId) {
      return negocioId == 'laparada'
        || (
          exists(/databases/$(database)/documents/negocios/$(negocioId))
          && get(/databases/$(database)/documents/negocios/$(negocioId)).data.estado == 'activo'
        );
    }

    function isTenantMember(negocioId) {
      return isSuperAdmin()
        || (hasProfileForTenant(negocioId) && tenantIsActive(negocioId));
    }

    function isTenantAdmin(negocioId) {
      return isSuperAdmin()
        || (
          isTenantMember(negocioId)
          && get(userProfilePath()).data.rol == 'admin'
        );
    }

    function isValidTenantId(negocioId) {
      return negocioId is string
        && negocioId.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function hasTenant(data) {
      return data.keys().hasAll(['negocioId'])
        && isValidTenantId(data.negocioId);
    }

    function canCreateTenantDocument() {
      return hasTenant(request.resource.data)
        && isTenantMember(request.resource.data.negocioId);
    }

    function canReadTenantDocument() {
      return hasTenant(resource.data)
        && isTenantMember(resource.data.negocioId);
    }

    function canUpdateTenantDocument() {
      return hasTenant(resource.data)
        && hasTenant(request.resource.data)
        && request.resource.data.negocioId == resource.data.negocioId
        && isTenantMember(resource.data.negocioId);
    }

    function canDeleteTenantDocument() {
      return hasTenant(resource.data)
        && isTenantMember(resource.data.negocioId);
    }

    function canAdminCreateTenantDocument() {
      return hasTenant(request.resource.data)
        && isTenantAdmin(request.resource.data.negocioId);
    }

    function canAdminUpdateTenantDocument() {
      return hasTenant(resource.data)
        && hasTenant(request.resource.data)
        && request.resource.data.negocioId == resource.data.negocioId
        && isTenantAdmin(resource.data.negocioId);
    }

    function canAdminDeleteTenantDocument() {
      return hasTenant(resource.data)
        && isTenantAdmin(resource.data.negocioId);
    }

    // Menú público; toda escritura queda aislada por negocio.
    match /productos/{productoId} {
      allow read: if true;
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /combos/{comboId} {
      allow read: if true;
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /categorias/{categoriaId} {
      allow read: if true;
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    // Perfil y negocio: lectura propia o administrativa. El alta pública solo
    // puede crear un negocio pendiente y su perfil propietario correspondiente.
    match /negocios/{negocioId} {
      allow read: if isSuperAdmin()
        || hasProfileForTenant(negocioId)
        || (
          isAuth()
          && resource.data.propietarioEmail == request.auth.token.email
        );

      allow create: if isAuth()
        && isValidTenantId(negocioId)
        && request.resource.data.id == negocioId
        && request.resource.data.propietarioEmail == request.auth.token.email
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.plan == 'basico';

      allow update: if isSuperAdmin()
        || (
          isTenantAdmin(negocioId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.propietarioEmail == resource.data.propietarioEmail
          && request.resource.data.estado == resource.data.estado
          && request.resource.data.plan == resource.data.plan
          && request.resource.data.creadoEn == resource.data.creadoEn
        );

      allow delete: if isSuperAdmin();
    }

    match /usuarios_negocio/{uid} {
      allow read: if isSuperAdmin()
        || (isAuth() && request.auth.uid == uid)
        || (
          resource.data.keys().hasAll(['negocioId'])
          && isTenantAdmin(resource.data.negocioId)
        );

      allow create: if isAuth()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.rol == 'admin'
        && request.resource.data.activo == true
        && isValidTenantId(request.resource.data.negocioId)
        && exists(/databases/$(database)/documents/negocios/$(request.resource.data.negocioId))
        && get(/databases/$(database)/documents/negocios/$(request.resource.data.negocioId)).data.estado == 'pendiente'
        && get(/databases/$(database)/documents/negocios/$(request.resource.data.negocioId)).data.propietarioEmail == request.auth.token.email;

      allow update: if isSuperAdmin()
        || (
          resource.data.keys().hasAll(['negocioId'])
          && isTenantAdmin(resource.data.negocioId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.negocioId == resource.data.negocioId
          && request.resource.data.creadoEn == resource.data.creadoEn
          && request.resource.data.rol in ['admin', 'cajero']
        );

      allow delete: if isSuperAdmin()
        || (
          resource.data.keys().hasAll(['negocioId'])
          && isTenantAdmin(resource.data.negocioId)
        );
    }

    match /ventas/{ventaId} {
      allow read: if canReadTenantDocument();
      // La identidad canónica es ventaId; nunca se duplica como dato mutable.
      allow create: if canCreateTenantDocument()
        && !request.resource.data.keys().hasAny(['id']);
      allow update: if canAdminUpdateTenantDocument()
        && !request.resource.data.keys().hasAny(['id']);
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /domicilios/{domicilioId} {
      // Los pedidos públicos entran exclusivamente por crearPedidoPublico (Admin SDK).
      // Se conserva la creación directa solo para el POS interno legado.
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument();
      allow update: if canUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    // Estado interno exclusivo de la Function de pedidos públicos.
    match /_idempotencia_pedidos_publicos/{registroId} {
      allow read, write: if false;
    }

    match /_limites_pedidos_publicos/{registroId} {
      allow read, write: if false;
    }

    match /_limites_whatsapp_manual/{registroId} {
      allow read, write: if false;
    }

    match /inventario/{insumoId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /entradas_inventario/{entradaId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /gastos/{gastoId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /cierres_caja/{cierreId} {
      allow read: if canReadTenantDocument();
      allow create: if canAdminCreateTenantDocument();
      allow update: if canAdminUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /cajas/{cajaId} {
      allow read: if canReadTenantDocument();
      allow create: if canCreateTenantDocument();
      allow update: if canUpdateTenantDocument();
      allow delete: if canAdminDeleteTenantDocument();
    }

    match /configuracion/{docId} {
      allow read: if canReadTenantDocument();
      allow create: if request.resource.data.negocioId == docId
        && canAdminCreateTenantDocument();
      allow update: if resource.data.negocioId == docId
        && canAdminUpdateTenantDocument();
      allow delete: if resource.data.negocioId == docId
        && canAdminDeleteTenantDocument();
    }

    match /transacciones_pago/{transaccionId} {
      // Colección histórica desactivada: LaParada no procesa pagos en línea.
      allow read, write: if false;
    }

    match /sesiones_pago/{sesionId} {
      // Colección histórica desactivada: no se crean sesiones de checkout.
      allow read, write: if false;
    }

    match /mensajes_whatsapp/{mensajeId} {
      allow read: if canReadTenantDocument();
      // Entradas, salidas y estados de proveedor solo los escribe el backend.
      // El cliente puede únicamente marcar como leído un mensaje entrante propio.
      allow create, delete: if false;
      allow update: if canUpdateTenantDocument()
        && resource.data.tipo == 'entrada'
        && resource.data.estado == 'entregado'
        && request.resource.data.estado == 'leido'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estado', 'actualizadoEn']);
      match /eventos_entrega/{evento} {
        allow read: if exists(/databases/$(database)/documents/mensajes_whatsapp/$(mensajeId))
            && isTenantMember(
              get(/databases/$(database)/documents/mensajes_whatsapp/$(mensajeId)).data.negocioId
            );
        allow create, update, delete: if false;
      }
    }

    // Chat en vivo entre un visitante de la tienda y el negocio.
    //
    // No hay backend propio donde validar, así que el contrato se hace cumplir
    // aquí: el id del documento ES el uid del visitante, de modo que la
    // propiedad se verifica sin leer nada y nadie puede abrir un hilo ajeno.
    function esDuenoDelChat(chatId) {
      return isAuth() && request.auth.uid == chatId;
    }

    function textoChatValido(valor) {
      return valor is string && valor.size() > 0 && valor.size() <= 1200;
    }

    function nombreChatValido(valor) {
      return valor is string && valor.size() >= 2 && valor.size() <= 80;
    }

    // Espeja CHAT_INTERVALO_MINIMO_SEGUNDOS: frena el spam desde el navegador
    // sin necesidad de una Function que lleve la cuenta.
    function respetaIntervaloChat() {
      return request.time > resource.data.ultimoMensajeEn + duration.value(2, 's');
    }

    match /chats/{chatId} {
      allow read: if esDuenoDelChat(chatId) || canReadTenantDocument();

      allow create: if esDuenoDelChat(chatId)
        && hasTenant(request.resource.data)
        && tenantIsActive(request.resource.data.negocioId)
        && request.resource.data.clienteUid == chatId
        && nombreChatValido(request.resource.data.clienteNombre)
        && request.resource.data.estado == 'abierto'
        && request.resource.data.ultimoMensaje == ''
        && request.resource.data.noLeidosAdmin == 0
        && request.resource.data.noLeidosCliente == 0;

      // El visitante solo toca su propio hilo, nunca cambia de negocio ni de
      // dueño, y no puede inflar el contador de no leídos del negocio.
      allow update: if (
          esDuenoDelChat(chatId)
          && request.resource.data.negocioId == resource.data.negocioId
          && request.resource.data.clienteUid == resource.data.clienteUid
          && request.resource.data.creadoEn == resource.data.creadoEn
          && nombreChatValido(request.resource.data.clienteNombre)
          && request.resource.data.estado in ['abierto', 'en_atencion', 'cerrado']
          && request.resource.data.noLeidosAdmin <= resource.data.noLeidosAdmin + 1
          && request.resource.data.noLeidosCliente <= resource.data.noLeidosCliente
          && (
            request.resource.data.ultimoMensajeEn == resource.data.ultimoMensajeEn
            || resource.data.ultimoMensaje == ''
            || respetaIntervaloChat()
          )
        )
        || canUpdateTenantDocument();

      allow delete: if canAdminDeleteTenantDocument();

      match /mensajes/{mensajeId} {
        function chatDelVisitante() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        allow read: if esDuenoDelChat(chatId)
          || isTenantMember(chatDelVisitante().negocioId);

        allow create: if textoChatValido(request.resource.data.texto)
          && request.resource.data.autorNombre is string
          && request.resource.data.autorNombre.size() <= 80
          && (
            (esDuenoDelChat(chatId) && request.resource.data.autor == 'cliente')
            || (
              isTenantMember(chatDelVisitante().negocioId)
              && request.resource.data.autor == 'asesor'
            )
          );

        // Un mensaje enviado es un hecho: no se reescribe.
        allow update: if false;
        allow delete: if isTenantAdmin(chatDelVisitante().negocioId);
      }
    }

    match /bot_queue/{queueId} {
      allow read, write: if false;
    }

    match /ordenes_pendientes/{ordenId} {
      allow read, write: if false;
    }

    match /_ordenes_whatsapp_activas/{registroId} {
      allow read, write: if false;
    }

    match /pin_attempts/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
